# local.nix — machine-specific overrides (not committed to git)
# Copy this file to local.nix and fill in your values.
{
  # Machine hostname (used by NixOS networking.hostName)
  hostname = "my-machine";

  # Username and home directory
  username = "hyb175";
  homeDirectory = "/home/hyb175";  # macOS: /Users/hyb175

  # Extra paths to add to Fish shell $PATH
  extraFishPaths = [
    # "/opt/homebrew/opt/mysql-client@8.0/bin"
  ];

  # Path to a CA bundle this machine's tooling must trust, e.g. one installed
  # by corporate MDM. Re-exported to every shell (macOS). null to skip.
  caBundle = null;

  # Whether nix-darwin manages /etc/zshrc, /etc/zshenv and /etc/bashrc.
  # Set false when something else owns them, such as an MDM agent, or
  # activation will refuse to overwrite them. Defaults to true.
  manageZshAndBash = true;

  # Extra fish interactive setup for this machine: version managers, employer
  # tooling, anything not worth committing. Sourced after the secrets file.
  extraFishInit = "";
  # extraFishInit = ''
  #     if test -x /opt/homebrew/bin/mise
  #         /opt/homebrew/bin/mise activate fish | source
  #     end
  # '';

  # Finance broker (NixOS only)
  financeBroker = {
    enable = false;
    binaryPath = "/path/to/finance-broker";
    configFile = "/path/to/config.toml";
    secretSource = "/path/to/simplefin_access_url";
  };
}
